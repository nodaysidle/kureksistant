<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        style="@style/TextMono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textSize="18sp"
        android:layout_marginBottom="16dp" />

    <TextView
        style="@style/TextMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:labelFor="@+id/editHost"
        android:text="@string/settings_host"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@id/editHost"
        style="@style/FieldInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/settings_host_hint"
        android:inputType="textUri"
        android:layout_marginBottom="12dp" />

    <TextView
        style="@style/TextMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:labelFor="@+id/editPort"
        android:text="@string/settings_port"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@id/editPort"
        style="@style/FieldInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="8790"
        android:inputType="number"
        android:layout_marginBottom="12dp" />

    <TextView
        style="@style/TextMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:labelFor="@+id/editToken"
        android:text="@string/settings_token"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@id/editToken"
        style="@style/FieldInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/settings_token_hint"
        android:inputType="textPassword"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextMono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_speak" />

            <TextView
                style="@style/TextMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_speak_sub" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchSpeakOutLoud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:minWidth="48dp"
            android:contentDescription="@string/settings_speak"
            android:thumbTint="@color/switch_thumb"
            android:trackTint="@color/switch_track" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnSaveSettings"
        style="@style/TextMono"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center"
        android:background="@drawable/bg_button_primary"
        android:textColor="@color/on_accent"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/settings_save" />
</LinearLayout>
</ScrollView>
