<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Top bar. Top padding is raised by the status-bar inset in MainActivity so the bar draws behind it. -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@color/surface_low"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextMono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title"
                android:textSize="18sp"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="@color/accent" />

                <TextView
                    android:id="@+id/txtStatus"
                    style="@style/TextMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/status_default" />

                <TextView
                    android:id="@+id/txtHostLabel"
                    style="@style/TextMeta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/host_unset" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnTerminal"
            style="@style/PresetButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/terminal"
            android:contentDescription="@string/terminal_desc" />

        <ImageButton
            android:id="@+id/btnSpeaker"
            style="@style/IconButton"
            android:src="@drawable/ic_volume_off"
            android:contentDescription="@string/speaker_desc" />

        <ImageButton
            android:id="@+id/btnSettings"
            style="@style/IconButton"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/settings_desc" />
    </LinearLayout>

    <View
        android:id="@+id/dividerTop"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/outline"
        app:layout_constraintTop_toBottomOf="@id/headerLayout" />

    <!-- Preset prompts -->
    <HorizontalScrollView
        android:id="@+id/quickChipsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/dividerTop">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:showDividers="middle"
            android:divider="@drawable/space_8">

            <TextView
                android:id="@+id/chipGrokbot"
                style="@style/PresetButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preset_grokbot" />

            <TextView
                android:id="@+id/chipSysStatus"
                style="@style/PresetButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preset_activity" />

            <TextView
                android:id="@+id/chipProjects"
                style="@style/PresetButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preset_projects" />

            <TextView
                android:id="@+id/chipScreen"
                style="@style/PresetButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preset_screen" />

            <TextView
                android:id="@+id/chipLive"
                style="@style/PresetButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preset_live"
                android:contentDescription="@string/preset_live_desc" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/quickChipsScroll"
        app:layout_constraintBottom_toTopOf="@id/bottomInputLayout" />

    <!-- Input bar. Bottom padding is raised by max(gesture-nav, IME) in MainActivity. -->
    <LinearLayout
        android:id="@+id/bottomInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/bg_input_bar"
        app:layout_constraintBottom_toBottomOf="parent">

        <EditText
            android:id="@+id/editPrompt"
            style="@style/FieldInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/prompt_hint"
            android:maxLines="4"
            android:inputType="textCapSentences|textMultiLine"
            android:imeOptions="actionSend" />

        <ImageButton
            android:id="@+id/btnSend"
            style="@style/IconButton"
            android:src="@drawable/ic_send"
            android:contentDescription="@string/send_desc" />

        <ImageButton
            android:id="@+id/btnMic"
            style="@style/IconButton"
            android:background="@drawable/bg_mic_button"
            android:src="@drawable/ic_mic"
            android:contentDescription="@string/mic_desc" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
