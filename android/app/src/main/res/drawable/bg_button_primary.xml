<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><corners android:radius="4dp" /><solid android:color="@color/accent" /><stroke android:width="2dp" android:color="@color/text" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><corners android:radius="4dp" /><solid android:color="@color/text_muted" /></shape>
    </item>
    <item><shape><corners android:radius="4dp" /><solid android:color="@color/accent" /></shape></item>
</selector>
