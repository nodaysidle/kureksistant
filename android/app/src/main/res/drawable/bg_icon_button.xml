<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><corners android:radius="4dp" /><stroke android:width="2dp" android:color="@color/accent" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><corners android:radius="4dp" /><solid android:color="@color/background" /></shape>
    </item>
    <item android:state_hovered="true">
        <shape><corners android:radius="4dp" /><solid android:color="@color/surface" /></shape>
    </item>
    <item><shape><corners android:radius="4dp" /><solid android:color="@android:color/transparent" /></shape></item>
</selector>
