<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><corners android:radius="20dp" /><solid android:color="@color/surface" /><stroke android:width="1.5dp" android:color="@color/accent" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><corners android:radius="20dp" /><solid android:color="@color/surface_low" /><stroke android:width="1dp" android:color="@color/outline" /></shape>
    </item>
    <item>
        <shape><corners android:radius="20dp" /><solid android:color="@color/surface" /><stroke android:width="1dp" android:color="@color/outline" /></shape>
    </item>
</selector>
