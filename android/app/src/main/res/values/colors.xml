<?xml version="1.0" encoding="utf-8"?>
<!-- Light palette, see android/DESIGN.md. Every text/background pair below reaches 4.5:1. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <color name="background">#F6F5F1</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_low">#EEEDE8</color>
    <color name="outline">#DAD7CF</color>
    <color name="text">#1B1C1A</color>
    <color name="text_muted">#5D605A</color>
    <color name="accent">#2E6B3A</color>
    <color name="accent_container">#DDEBDD</color>
    <color name="on_accent">#FFFFFF</color>
    <color name="warn">#8A5A00</color>
    <color name="warn_container" tools:ignore="UnusedResources">#F6E7C6</color>
    <color name="error">#B3261E</color>
    <color name="error_container">#F9DEDC</color>
    <color name="offline">#8B8E88</color>
</resources>
