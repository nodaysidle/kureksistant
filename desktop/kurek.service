[Unit]
Description=Kurek AI Assistant Daemon for Arch Linux / Hyprland
After=graphical-session.target pipewire.service
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=@KUREK_DIR@
ExecStart=@KUREK_DIR@/.venv/bin/python -u @KUREK_DIR@/kurek_daemon.py
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

# Resource Envelope (observed ~452MiB peak with faster-whisper loaded)
MemoryHigh=512M
MemoryMax=600M

[Install]
WantedBy=graphical-session.target
