# ==============================================================================
# Kurek (Kureksistant) Environment Configuration
# ==============================================================================

# [REQUIRED] Brain: DeepSeek Direct Platform API Key (api.deepseek.com)
# Used for reasoning, tool dispatch, and dialogue generation with DeepSeek-Flash.
DEEPSEEK_API_KEY=sk-your-deepseek-key

# [REQUIRED] Voice: xAI Cloud API Key (api.x.ai)
# Used for real-time speech generation with Grok Cloud TTS (voice: Sol).
# Without it (or when a request fails) Kurek falls back to local `spd-say`.
XAI_API_KEY=xai-your-xai-key

# [OPTIONAL / RECOMMENDED] Google Gemini API Key
# Used by screen vision and the Gemini-backed tools (code_helper, dev_agent,
# file_processor, flight_finder, youtube_video, web_search).
GEMINI_API_KEY=AIzaSy-your-gemini-key

# ------------------------------------------------------------------------------
# Speech recognition (STT)
# ------------------------------------------------------------------------------
# Order: OpenRouter Whisper (if OPENROUTER_API_KEY is set) → Deepgram Nova-2
# (if DEEPGRAM_API_KEY is set) → local faster-whisper. When a cloud key is set,
# your recorded VOICE AUDIO is sent to that provider; if the cloud call fails,
# Kurek falls back to local faster-whisper for that utterance.
# With no cloud key, everything stays local.
DEEPGRAM_API_KEY=
# openrouter (default) | deepgram — which cloud provider to prefer when both keys exist.
# KUREK_STT_PROVIDER=openrouter
# OPENROUTER_STT_MODEL=openai/whisper-large-v3-turbo
# Local model: base.en (English-only, default), or multilingual base / small / medium.
# KUREK_WHISPER_MODEL=base.en

# Listening window (seconds)
# KUREK_SILENCE_DURATION=2.2          # silence after speech before auto-submit
# KUREK_INITIAL_SILENCE_TIMEOUT=6.0   # give up if no speech starts
# KUREK_MAX_RECORD_SECONDS=30.0       # hard cap per utterance

# [OPTIONAL] Cognition: TypeSafe Jev System One Engine
# Used for cognitive snap-judgment triage and boundary hoisting.
TYPESAFE_API_KEY=

# [OPTIONAL] OpenRouter: speech recognition (see above) AND auto screen-context
# (Decision-1, falls back to TypeSafe). When set, each prompt text is sent to
# OpenRouter for needs_screen detection, and voice audio for transcription.
# Opt out with KUREK_AUTO_SCREEN=0. Timeout override: KUREK_DECISION_TIMEOUT (seconds).
OPENROUTER_API_KEY=
KUREK_AUTO_SCREEN=1
# KUREK_DECISION_TIMEOUT=1.5

# ------------------------------------------------------------------------------
# Personalization (optional — leave blank for neutral defaults)
# ------------------------------------------------------------------------------

# How Kurek addresses you in the system prompt (e.g. "Alex"). Empty = "the user".
KUREK_USER_NAME=

# Optional Hermes memory integration:
# - HERMES_PROFILE: use ~/.hermes/profiles/<name>/memories
# - HERMES_MEMORIES_DIR: absolute/tilde path override (wins over profile)
# If both are empty, Kurek only checks ~/.hermes/memories when present.
HERMES_PROFILE=
HERMES_MEMORIES_DIR=

# Display name fallback when KUREK_USER_NAME is empty.
# USER_DISPLAY_NAME=

# Optional microphone name substring (e.g. "USB Microphone"). Empty = system default.
INPUT_DEVICE=

# Project roots the codebase tool may read (separated by : ; or ,).
# KUREK_CODEBASE_ROOTS=~/dev:~/Projects     (KUREK_PROJECT_ROOTS is an alias)

# Desktop notifications for state changes: minimal (default: Listening and
# Thinking only), all, or off.
# KUREK_STATE_NOTIFY=minimal

# Max characters of each memory file (~/MEMORY.md, ~/ALIGNMENT_SYNTHESIS.md,
# Hermes USER.md/MEMORY.md) injected into every prompt. Head + newest tail kept.
# KUREK_MEMORY_FILE_MAX_CHARS=6000

# Print per-query latency marks to the log.
# KUREK_TIMING=1

# ------------------------------------------------------------------------------
# Phone remote (Android over Tailscale) — all empty by default (loopback only)
# ------------------------------------------------------------------------------
# Generate a strong token: openssl rand -hex 32
# Then set KUREK_REMOTE_BIND=tailscale and restart the daemon.
# Enter the PC Tailscale IP/MagicDNS name and the same token in the Android app.
KUREK_REMOTE_TOKEN=
KUREK_REMOTE_BIND=
# Optional explicit bind host (e.g. 127.0.0.1). Use 0.0.0.0 only if you understand
# the risk; remote bind always requires KUREK_REMOTE_TOKEN (>= 32 chars).
KUREK_BIND=
# Set to 1 to let remote prompts run desktop_control/code_helper/dev_agent/run/
# codebase. Also enables the run tool's unrestricted shell (local and remote).
KUREK_REMOTE_ALLOW_EXEC=
# Set to 1 so remote prompts also speak on the PC speakers (default: silent).
# KUREK_REMOTE_LOCAL_TTS=
