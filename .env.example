# ==============================================================================
# Kurek (Kureksistant) Environment Configuration
# ==============================================================================

# [REQUIRED] Brain: DeepSeek Direct Platform API Key (api.deepseek.com)
# Used for reasoning, tool dispatch, and dialogue generation with DeepSeek-Flash.
DEEPSEEK_API_KEY=sk-your-deepseek-key

# [REQUIRED] Voice: xAI Cloud API Key (api.x.ai)
# Used for real-time speech generation with Grok Cloud TTS (voice: Sol).
XAI_API_KEY=xai-your-xai-key

# [OPTIONAL / RECOMMENDED] Screen Vision: Google Gemini API Key
# Used for zero-latency screen vision & active Hyprland window perception.
GEMINI_API_KEY=AIzaSy-your-gemini-key

# [OPTIONAL / RECOMMENDED] STT: Deepgram Nova-2 API Key
# Sub-second voice transcription with adaptive silence detection.
# If omitted or empty, falls back to local faster-whisper (base.en).
DEEPGRAM_API_KEY=your-deepgram-key

# [OPTIONAL] Cognition: TypeSafe Jev System One Engine
# Used for sub-60ms cognitive snap-judgment triage and boundary hoisting.
TYPESAFE_API_KEY=your-typesafe-key
